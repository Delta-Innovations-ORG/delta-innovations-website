# EmailJS — contact form (create .env.local from this file; never commit secrets)

VITE_EMAILJS_SERVICE_ID=service_mvp30ck
VITE_EMAILJS_TEMPLATE_ID=template_td3uvm9
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
VITE_EMAILJS_PRIVATE_KEY=your_private_key_here

# Setup: https://www.emailjs.com
# 1. Connect Gmail under Email Services (e.g. service_mvp30ck → daltainnovations.co@gmail.com)
# 2. Template To Email: daltainnovations.co@gmail.com (optional CC: insider.daltainnovations@gmail.com)
#    Reply-To: {{client_email}} — use template_td3uvm9 (Contact Us template)
# 3. Account → Security → enable "Use Private Key (recommended)"
# 4. Paste Public Key + Private Key from Account → API Keys
# 5. Restart npm run dev after editing .env.local
