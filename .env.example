# Public site URL (SEO canonical, sitemap, Open Graph)
VITE_SITE_URL=https://delta-innovations-website.vercel.app

# Clerk — authentication (https://dashboard.clerk.com)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

# EmailJS — contact form (server-side only for private key)
VITE_EMAILJS_SERVICE_ID=service_mvp30ck
VITE_EMAILJS_TEMPLATE_ID=template_td3uvm9
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
EMAILJS_PRIVATE_KEY=your_private_key_here
# Optional server aliases (Vercel production)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# Tawk.to — live chat (loads on every visit)
VITE_TAWK_PROPERTY_ID=6a19f7b6bfd8e61c339dc6b9
VITE_TAWK_WIDGET_ID=1jpqmv8b7

# GitHub — marketplace catalog (server-side only)
# PAT with public_repo (public repos) or repo scope (private repos)
GITHUB_TOKEN=

# Stripe — checkout & webhooks (Phase 2B stub)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Setup notes:
# 1. Copy to .env.local for local dev; add secrets in Vercel for production
# 2. GITHUB_TOKEN must be in .env.local AND Vercel Dashboard (Development + Production)
# 3. After editing .env.local, restart npm run dev:api (Ctrl+C then run again)
# 4. Never commit .env.local; never use VITE_ prefix for private keys
